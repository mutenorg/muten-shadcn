# Accordion - stacked questions; each opens to its content's exact height (200 ms) and the arrow turns instead of
# swapping icons. The page owns a bool per item and the toggle.
#   Accordion { AccordionItem(title: "¿Puedo cancelar mi cita?", open: a1, onToggle: t1) { Text "Sí, hasta 3 horas antes…" } }
# shadcn-for-muten · part · no deps · Nova (.cn-accordion) + kit.css.
part Accordion() { Stack class("cn-accordion") data(slot: "accordion") { slot } }
part AccordionItem(title: text, open: bool, onToggle: action) {
  Stack class("cn-accordion-item") data(slot: "accordion-item") {
    Button -> $onToggle class("cn-accordion-trigger group/accordion-trigger") data(slot: "accordion-trigger") aria(expanded: $open) {
      Span "{$title}"
      Icon "lucide:chevron-down" class("cx-acc-chev")
    }
    Stack class("cn-accordion-content cx-acc-fold") data(slot: "accordion-content", open: $open) aria(role: "region") {
      Stack class("cn-accordion-content-inner") { slot }
    }
  }
}
