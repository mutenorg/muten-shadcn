# Alert + sub-components. variant: default | destructive.
# Compose: Alert(variant) { Icon … ; Stack { AlertTitle(label) AlertDescription(label) } }
# shadcn-for-muten · part · no deps · styles via the semantic .alert* classes in globals.css.
part Alert(variant: text) {
  Section class("alert", "alert-default" when $variant == "default", "alert-destructive" when $variant == "destructive") { slot }
}
part AlertTitle(label: text) { Span "{$label}" class("alert-title") }
part AlertDescription(label: text) { Span "{$label}" class("alert-description") }
