# AssistantPlay - the assistant at work, shown (not used): a card with the day, the assistant typing, saying what it did
# and the new booking dropping into the day, the counter going up, the orb smiling. It loops every 10 s; reduced
# motion shows the end (the booking in, the message said). The rows of the day go in the slot (Item + ItemSeparator).
#   AssistantPlay(title: "Hoy, martes 14", before: "3 citas · 2 pedidos", after: "4 citas · 2 pedidos",
#     newTitle: "Carla S.", newLine: "4:30 PM · Corte clásico · la agendó tu asistente", newBadge: "Nueva",
#     message: "¡Listo! Agendé a Carla hoy a las 4:30 PM.") {
#     Item(size: "sm") { ItemContent() { ItemTitle(label: "Laura M.")  ItemDescription(label: "9:00 AM · Corte clásico") } }
#     ItemSeparator()
#     …
#   }
# It fills its container (relative): the card at the top left, the orb at the bottom right, the bubble beside it. Put
# it on a dark panel (the orb glows); the pointer over that panel is followed by the orb's eyes.
# shadcn-for-muten · parts (Card, Item, StatusBadge, AssistantOrb) + Custom AssistantPlay · kit.css (.cx-ap).
part AssistantPlay(title: text, before: text, after: text, newTitle: text, newLine: text, newBadge: text = "", message: text) {
  Stack class("cx-ap") data(area: "orb") {
    Card(size: "sm") class("cx-ap-card") {
      CardHeader() {
        CardTitle(label: $title)
        CardAction() {
          Stack class("cx-ap-count") { Span "{$before}" class("cx-ap-count-a")  Span "{$after}" class("cx-ap-count-b") }
        }
      }
      CardContent() {
        ItemGroup() {
          slot
          Stack class("cx-ap-new") {
            ItemSeparator()
            Item(size: "sm") class("cx-ap-flash") {
              ItemContent() { ItemTitle(label: $newTitle)  ItemDescription(label: $newLine) }
              when $newBadge != "" { ItemActions() { StatusBadge(label: $newBadge, tone: "ok") } }
            }
          }
        }
      }
    }
    Stack class("cx-ap-typing") { Span "" class("cx-ap-dot")  Span "" class("cx-ap-dot")  Span "" class("cx-ap-dot") }
    Span "{$message}" class("cx-ap-said") aria(live: "polite")
    AssistantOrb(size: "320") class("cx-ap-orb")
    Custom AssistantPlay class("cx-ap-run")
  }
}
