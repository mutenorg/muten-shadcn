# Badge - a short label. `StatusBadge` is the system's state: a dot and the word, never a tinted pill.
#   Badge(label: "Nuevo")                         Badge(label: "PRO", variant: "default")
#   StatusBadge(label: "Confirmada", tone: "ok")  StatusBadge(label: "Por revisar", tone: "wait")
# Badge variant: default | secondary | destructive | outline | ghost | link   (default: secondary)
# StatusBadge tone: ok | wait | info | bad | "" (neutral)
# shadcn-for-muten · part · no deps · Nova (.cn-badge) + kit.css (status).
part Badge(label: text, variant: text = "secondary") { Span "{$label}" class("cn-badge cn-badge-variant-{$variant} group/badge") data(slot: "badge") }
part StatusBadge(label: text, tone: text = "") { Span "{$label}" class("cn-badge cn-badge-variant-ghost group/badge") data(slot: "badge", variant: "status", tone: $tone) }
# ToneBadge - a state with its tone, tinted, with or without a dot: new | ok | wait | bad | pro (PRO uses --selected).
#   ToneBadge(label: "Confirmado", tone: "ok")    ToneBadge(label: "Pendiente", tone: "wait", dot: "dot")
part ToneBadge(label: text, tone: text, dot: text = "") {
  Stack class("cn-badge group/badge cx-tone-{$tone}") data(slot: "badge") {
    when $dot != "" { Span "" class("cx-dot") }
    Span "{$label}"
  }
}
# Chip - a value the person can take away with its ×; it fades out (no jump). The page owns the list.
#   each tags as t { Chip(label: t.name, onRemove: removeTag) }   with   action removeTag(name: text) mutates tags { … }
part Chip(label: text, onRemove: action) {
  Stack class("cn-badge cn-badge-variant-secondary cx-chip") data(slot: "badge") {
    Span "{$label}"
    Button -> $onRemove($label) class("cn-button cn-button-variant-ghost cn-button-size-icon-xs cx-chip-x") aria(label: "Quitar {$label}") { Icon "lucide:x" }
  }
}
