# CanvasViewport - a canvas you move by dragging and zoom with the wheel (around the pointer), with muten content
# floating over it (a Toolbar, a ZoomControl). The page can set the zoom and hears it change; a double click goes
# back to 100 %. The placeholder scene is in canvas-viewport.js: replace its draw() with yours.
#   CanvasViewport(zoom: zoom, onView: setZoom) { Toolbar { … } }
# shadcn-for-muten · part + Custom (CanvasHost) · kit.css (.cx-canvas) · host JS canvas-viewport.js.
part CanvasViewport(zoom: number = 100, height: text = "360px", onView: action) {
  Stack class("cx-canvas") data(slot: "canvas-viewport") style(h: "{$height}") {
    Custom CanvasHost inputs(zoom: $zoom) on(view: $onView) class("cx-canvas-host")
    Stack class("cx-canvas-over") { slot }
  }
}
