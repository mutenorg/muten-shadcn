# Combobox - type and the list filters (accent-insensitive) and marks the match; arrows, Enter, Esc; «Usar «…»» to
# keep something that is not in the list (allowNew "off" to forbid it). options is comma-joined text.
#   Combobox(label: "Ciudad", options: "Bogotá,Medellín,Cali", placeholder: "Escribe tu ciudad", onChange: setCity)
# shadcn-for-muten · Custom (kit menus) · host JS combobox.js.
part Combobox(label: text = "", options: text, value: text = "", placeholder: text = "", allowNew: text = "on", hint: text = "on", onChange: action) {
  Custom Combobox inputs(label: $label, options: $options, value: $value, placeholder: $placeholder, allowNew: $allowNew, hint: $hint) on(change: $onChange) class("cx-cb-host")
}
