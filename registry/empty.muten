# Empty - what a list says when it has nothing yet: the icon in the slot, a title, a description. Put the way out
# (a button) right after it.
#   Empty(title: "Nada por aquí", description: "Cuando te escriban, aparece aquí.") { Icon "lucide:inbox" }
# shadcn-for-muten · part · no deps · Nova (.cn-empty).
part Empty(title: text, description: text = "") {
  Stack class("cn-empty") data(slot: "empty") {
    Stack class("cn-empty-header") data(slot: "empty-header") {
      Stack class("cn-empty-media cn-empty-media-icon") data(slot: "empty-icon", variant: "icon") { slot }
      Span "{$title}" class("cn-empty-title") data(slot: "empty-title")
      Text "{$description}" class("cn-empty-description") data(slot: "empty-description")
    }
  }
}
