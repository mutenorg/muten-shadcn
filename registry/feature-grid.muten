# FeatureGrid - what a product does, as cards in a grid that wraps (three, two or one per row by the width). Each
# FeatureCard has its icon in the slot, a title and a line.
#   FeatureGrid { FeatureCard(title: "Agenda", description: "Citas por persona y recordatorios.") { Icon "lucide:calendar" } … }
# shadcn-for-muten · parts · no deps · kit.css (.cx-features).
part FeatureGrid(columns: number = 3) { Stack class("cx-features") style(cols: "{$columns}") { slot } }
part FeatureCard(title: text, description: text) {
  Stack class("cx-feature") {
    Stack class("cx-feature-ic") { slot }
    Title "{$title}" h3 class("cx-feature-t")
    Text "{$description}" class("cx-feature-d")
  }
}
