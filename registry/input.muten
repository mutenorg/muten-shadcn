# Input - a text field bound to a page text state. TextArea - the same for several lines (`Textarea` is muten's
# primitive, so the part is TextArea).
#   Input(value: name, placeholder: "Nombre o teléfono")      TextArea(value: notes, placeholder: "Notas para el equipo")
# shadcn-for-muten · part · no deps · Nova (.cn-input, .cn-textarea).
part Input(value: text, placeholder: text = "") { SearchField bind($value) "{$placeholder}" class("cn-input") data(slot: "input") }
part TextArea(value: text, placeholder: text = "") { Textarea bind($value) "{$placeholder}" class("cn-textarea") data(slot: "textarea") }
