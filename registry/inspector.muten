# Inspector - the right panel of an editor: sections that fold (Transform, Apariencia), each a list of rows with the
# property's name on the left and its control on the right (a NumberField, a Switch, a ColorPicker…). The page owns
# whether each section is open.
#   Inspector {
#     InspectorSection(label: "Transform", open: tOpen, onToggle: toggleT) {
#       InspectorRow(label: "Posición") { VectorField(…) }  InspectorRow(label: "Rotación") { NumberField(…) }
#     }
#   }
# shadcn-for-muten · parts · no deps · kit.css (.cx-insp, the Accordion's fold).
part Inspector(label: text = "Propiedades") { Stack class("cx-insp") data(slot: "inspector") aria(label: $label) { slot } }
part InspectorSection(label: text, open: bool, onToggle: action) {
  Stack class("cx-insp-sec") data(open: $open) {
    Button -> $onToggle class("cx-insp-head") aria(expanded: $open) { Span "{$label}"  Icon "lucide:chevron-down" class("cx-acc-chev") }
    Stack class("cn-accordion-content cx-acc-fold") data(open: $open) aria(role: "region", label: $label) { Stack class("cn-accordion-content-inner cx-insp-body") { slot } }
  }
}
part InspectorRow(label: text) { Stack class("cx-insp-row") { Span "{$label}" class("cx-insp-label")  Stack class("cx-insp-ctl") { slot } } }
