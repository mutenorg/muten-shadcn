# LogoCloud - the "trusted by" strip: a wrapping row of logos, muted + grayscale until hover. GENERIC - a
# LogoCloudItem holds ANY logo type: an Image, an Icon, or a plain text wordmark (Span). All normalize to one
# height. Give it a heading above via a plain Text.
#   LogoCloud {
#     LogoCloudItem { Image "~/logos/acme.svg" alt("Acme") }   # image logo
#     LogoCloudItem { Icon "simple-icons:vercel" }             # icon logo
#     LogoCloudItem { Span "Globex" class("text-lg font-bold tracking-tight") }   # text wordmark
#   }
# shadcn-for-muten · block · no deps · styles via .logo-cloud / .logo-cloud-item in globals.css.
part LogoCloud() { Stack class("logo-cloud") { slot } }
part LogoCloudItem() { Stack class("logo-cloud-item") { slot } }
