# MemberList - any group (team, workspace, family plan): who is in, their role in the library's menu, invite.
#   MemberList(members: @members, roles: @roles, owner: "Owner", one: "member", many: "members", cta: "Invite", note: "They get an email to join.")
# shadcn-for-muten · part over KitWidget (kit core).
part MemberList(members: list, roles: list, owner: text = "", one: text = "person", many: text = "people", cta: text = "Invite", note: text = "") {
  Custom KitWidget inputs(name: "memberList", members: $members, roles: $roles, owner: $owner, one: $one, many: $many, cta: $cta, note: $note) class("cx-team")
}
