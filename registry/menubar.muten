# Menubar - a desktop app's menu bar: each word opens its menu; once one is open, moving the pointer to the next word
# opens that one, and the left and right arrows walk the bar. Each menu holds DropdownContent and its items.
#   Menubar(label: "Editor") {
#     MenubarMenu { MenubarTrigger(label: "Archivo")  DropdownContent { DropdownItem(label: "Nuevo", shortcut: "⌘N", onSelect: create) … } }
#     MenubarMenu { MenubarTrigger(label: "Editar")  DropdownContent { … } }
#   }
# shadcn-for-muten · parts + Custom (OverlayBehavior) · Nova (.cn-menubar*) + kit.css.
part Menubar(label: text = "Menú") { Stack class("cn-menubar cx-menubar") data(slot: "menubar") aria(role: "menubar", label: $label) { slot } }
part MenubarMenu() { Stack class("cx-ov") data(slot: "menubar-menu") { slot  OverlayBehavior(kind: "menubar") } }
part MenubarTrigger(label: text) { Stack class("cx-ov-trigger") { Button "{$label}" class("cn-menubar-trigger") data(slot: "menubar-trigger") aria(role: "menuitem") } }
