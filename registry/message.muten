# Message - a chat bubble, the same the kit's inbox draws: theirs on the left on the surface, yours on the right in
# the primary colour, with the time and, on yours, whether it was sent, delivered or read. Text, a photo or an
# Attachment go inside. Marker is the day line between messages; MessageScroller holds them and scrolls.
#   MessageScroller(label: "Chat with Valentina") {
#     Marker(label: "Today")
#     Message(variant: "received", time: "10:02") { Span "Hi, do you have an appointment today?" }
#     Message(variant: "sent", time: "10:03", status: "read") { Span "Yes: at 15:00 with Camila." }
#   }
# variant: received | sent · status (sent only): sending | sent | delivered | read · tag: a small label (Bot).
# shadcn-for-muten · parts · no deps · kit.css (.cx-chat-*).
part Message(variant: text = "received", time: text = "", status: text = "", tag: text = "") {
  Stack class("cx-chat-msg") data(variant: $variant) {
    Stack class("cx-chat-bubble cx-msg-bubble") {
      Stack class("cx-msg-body") { slot }
      Stack class("cx-chat-meta") {
        Span "{$tag}" class("cx-chat-tag")
        Span "{$time}" class("cx-text") data(variant: "caption")
        when $status == "sending" { Icon "lucide:clock" class("cx-tick") data(status: "sending", trl: "Sending") aria(label: "Sending") }
        when $status == "sent" { Icon "lucide:check" class("cx-tick") data(status: "sent", trl: "Sent") aria(label: "Sent") }
        when $status == "delivered" { Icon "lucide:check-check" class("cx-tick") data(status: "delivered", trl: "Delivered") aria(label: "Delivered") }
        when $status == "read" { Icon "lucide:check-check" class("cx-tick") data(status: "read", trl: "Read") aria(label: "Read") }
      }
    }
  }
}
part Bubble(variant: text = "received") { Stack class("cx-chat-bubble cx-msg-bubble") data(variant: $variant) { slot } }
part Marker(label: text) { Stack class("cx-chat-day") aria(role: "separator") { Span "{$label}" class("cx-text") data(variant: "caption") } }
part MessageImage(src: text, alt: text = "Photo") { Stack class("cx-chat-img") style(bg: "{$src}") data(trl: $alt) aria(role: "img", label: $alt) }
