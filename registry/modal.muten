# Modal - THE adaptive modal: a Dialog on a wide screen, a Drawer from the bottom on a phone (mode "auto"), or forced
# with mode "dialog" | "drawer". The page owns the open bool; the overlay, the ✕, Esc, the phone's Back button and a
# drag down on the drawer all call onClose. Content goes in the slot; the buttons in a ModalFooter (it sticks under
# the scrolling body): the way out (cx-exit) on the left, the action (cx-go) filling the rest.
#   state { editing = false : bool }   action edit() mutates editing { editing.set(true) }   action done() mutates editing { editing.set(false) }
#   Modal(open: editing, onClose: done, title: "Edit service", description: "What you change shows in your shop when you save.") {
#     Field { … }
#     ModalFooter { Btn(variant: "outline", onClick: done) class("cx-exit") { Span "Cancel" }  Btn(onClick: save) class("cx-go") { Span "Save changes" } }
#   }
# mode: auto | dialog | drawer | sheet (a panel from a side) | anchor (a card beside what was tapped)
# side: right | left | top | bottom (for sheet) · anchor: "x,y,w,h" of what was tapped, in the viewport (for anchor;
# with none it opens as a dialog). AgendaLive's onOpen sends it as `at`, so a cita opens beside itself.
# role: dialog | alertdialog · dismiss: on | off (off: no ✕ and the backdrop does not close it; only its buttons do)
# size: "" | tall (a list that pages)   ·   shadcn-for-muten · part + Custom (ModalBehavior) · kit.css (.cx-modal).
part Modal(open: bool, onClose: action, title: text = "", description: text = "", mode: text = "auto", size: text = "", side: text = "right", role: text = "dialog", dismiss: text = "on", anchor: text = "") {
  Stack class("cx-modal-root") data(open: $open) {
    when $dismiss != "off" { Button "" -> $onClose class("cx-overlay") aria(label: "Close", hidden: "true") data(closes: "true", trl: "Close") }
    when $dismiss == "off" { Stack class("cx-overlay") aria(hidden: "true") }
    Stack class("cx-modal") data(mode: $mode, want: $mode, size: $size, side: $side) aria(role: $role, modal: "true", label: $title) {
      Stack class("cx-handle") aria(hidden: "true")
      Stack class("cx-modal-head") data(drag: "true") {
        Span "{$title}" class("cx-modal-title")
        Span "{$description}" class("cx-modal-desc")
      }
      when $dismiss != "off" { Btn(variant: "ghost", size: "icon-sm", label: "Close", onClick: $onClose) class("cx-modal-x") { Icon "lucide:x" } }
      Stack class("cx-modal-body") { slot }
      ModalBehavior(open: $open, onClose: $onClose, anchor: $anchor)
    }
  }
}
part ModalFooter() { Stack class("cx-modal-foot") data(slot: "modal-footer") { slot } }
