# Navigation Menu - a nav bar whose items reveal a panel on hover (pure CSS, no state).
#   NavigationMenu { NavigationMenuItem(label: "Getting started") { NavigationMenuLink(title: "Intro", desc: "…", href: "/intro") … } }
# shadcn-for-muten · part · no deps · styles via the semantic .nav-menu* classes in globals.css.
part NavigationMenu() { Stack class("nav-menu") { slot } }
part NavigationMenuItem(label: text) {
  Stack class("nav-menu-item") {
    Span "{$label}" class("nav-menu-trigger")
    Stack class("nav-menu-content") { slot }
  }
}
part NavigationMenuLink(title: text, desc: text, href: text) {
  Link "" -> "{$href}" class("nav-menu-link") {
    Span "{$title}" class("nav-menu-link-title")
    Span "{$desc}" class("nav-menu-link-text")
  }
}
