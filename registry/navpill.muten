# NavPill - a landing page's floating glass bar: it stays on top as you scroll, firming up (more opaque, a shadow)
# once the page moves. The logo on the left, links and the call to action on the right (they lay out apart).
#   NavPill(label: "Principal") {
#     Stack class("cx-hstack") { Icon "lucide:store"  Span "Storio" class("font-semibold") }
#     Stack class("cx-hstack") { Link "Precios" -> "/precios"  LinkBtn(to: "/signup", size: "sm") { Span "Crear mi tienda" } }
#   }
# shadcn-for-muten · part · no deps · kit.css (.cx-navpill, scroll-driven where the browser supports it).
part NavPill(label: text = "Principal") { Stack class("cx-navpill-wrap") { Nav class("cx-navpill") aria(label: $label) { slot } } }
