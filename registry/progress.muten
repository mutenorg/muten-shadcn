# Progress - a determinate bar, value 0-100; it eases between values.  Progress(value: done, label: "Pasos hechos")
# shadcn-for-muten · part · no deps · Nova (.cn-progress) + kit.css (the value rides --w).
part Progress(value: number, label: text = "Progreso") {
  Stack class("cn-progress") data(slot: "progress") aria(role: "progressbar", label: $label, valuemin: 0, valuemax: 100, valuenow: $value) {
    Stack class("cn-progress-indicator") data(slot: "progress-indicator") style(w: "{$value}%")
  }
}
