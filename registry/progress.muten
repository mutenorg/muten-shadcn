# Progress - a determinate progress bar. value is 0-100; the fill width is the one runtime value, set via style().
# shadcn-for-muten · part · no deps · styles via the semantic .progress* classes in globals.css.
part Progress(value: number) {
  Stack class("progress") {
    Stack class("progress-indicator") style(w: "{$value}%")
  }
}
