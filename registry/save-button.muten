# SaveButton - saving takes three moments and the button keeps its width through them, so nothing jumps:
# idle (“Save changes”) → saving (spinner, “Saving…”) → saved (check, “Saved”, green). The page owns status.
#   SaveButton(status: saveState, onClick: save)      status: idle | saving | saved
# shadcn-for-muten · part · no deps · kit.css (.cx-save).
part SaveButton(status: text, onClick: action, label: text = "Save changes") {
  Button -> $onClick class("cn-button cn-button-variant-default cn-button-size-default group/button cx-save") data(slot: "button", status: $status) {
    when $status == "saving" { Stack class("cx-btn-label") { Icon "lucide:loader-circle" class("animate-spin")  Span "Saving…" data(tr: "Saving…") } }
    when $status == "saved" { Stack class("cx-btn-label") { Icon "lucide:check"  Span "Saved" data(tr: "Saved") } }
    when $status != "saving" and $status != "saved" { Stack class("cx-btn-label") { Span "{$label}" data(tr: $label) } }
  }
}
