# Segmented Control - a single-select toolbar (tool picker, view switch) on the kit's tabs track: the chosen one
# sits on a sliding pill (TabsBehavior), arrows move between items. The PAGE owns a text state:
#   state { tool = "select" : text }   action setTool(v: text) mutates tool { tool.set(v) }
#   SegmentedControl { SegmentedItem(value: "select", current: tool, label: "Select", onSelect: setTool) … }
# SegmentedTabs fills its width; IconTab holds an Icon instead of a label.
# shadcn-for-muten · part + Custom (TabsBehavior) · kit.css (.cx-tabs).
part SegmentedControl() { Stack class("cx-tabs") data(slot: "segmented") aria(role: "group") { slot  TabsBehavior() } }
part SegmentedItem(value: text, current: text, label: text, onSelect: action) {
  Button "{$label}" -> $onSelect($value) class("cn-button cn-button-variant-ghost cn-button-size-sm cx-tab") aria(pressed: $value == $current)
}
part SegmentedTabs() { Stack class("cx-tabs cx-tabs-fill") data(slot: "segmented") { slot  TabsBehavior() } }
part IconTab(value: text, current: text, onSelect: action) {
  Button -> $onSelect($value) class("cn-button cn-button-variant-ghost cn-button-size-icon-sm cx-tab") aria(pressed: $value == $current) { slot }
}
