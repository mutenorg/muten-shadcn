# Select - a dropdown that shows the chosen value. The PAGE owns the value (text) + the open bool + actions:
#   state { fruit = "Apple" : text  open = false : bool }   action setFruit(v: text) mutates fruit { fruit.set(v) … }
#   Select(value: fruit, open: open, onToggle: t) { SelectItem(value: "Apple", current: fruit, label: "Apple", onSelect: setFruit) … }
# Each SelectItem's action should set the value AND close. The backdrop catches outside clicks.
# shadcn-for-muten · part · no deps · styles via the semantic .select* classes in globals.css.
part Select(value: text, open: bool, onToggle: action) {
  Stack class("select-wrap") {
    Button -> $onToggle aria(expanded: $open) class("select-trigger") {
      Span "{$value}"
      Icon "lucide:chevrons-up-down" class("size-4 opacity-50")
    }
    when $open { Button -> $onToggle class("select-backdrop") }
    Stack class("select-content", "select-content-open" when $open) { slot }
  }
}
part SelectItem(value: text, current: text, label: text, onSelect: action) {
  Button -> $onSelect($value) class("select-item") {
    Span "{$label}"
    when $value == $current { Icon "lucide:check" class("size-4") }
  }
}
