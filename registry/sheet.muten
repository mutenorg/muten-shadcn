# Sheet - a panel that slides in from the right edge. The PAGE owns the bool + open/close actions:
#   state { open = false : bool }   action close mutates open { open.set(false) }   Sheet(open: open, onClose: close) { … }
# shadcn-for-muten · part · no deps · backdrop click closes; styles via the semantic .sheet* classes.
part Sheet(open: bool, onClose: action) {
  Stack class("sheet-overlay", "sheet-overlay-open" when $open) {
    Button -> $onClose class("sheet-backdrop")
    Stack class("sheet-content") { slot }
  }
}
part SheetTitle(label: text) { Title "{$label}" h2 class("sheet-title") }
part SheetDescription(label: text) { Span "{$label}" class("sheet-description") }
