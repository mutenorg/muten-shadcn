# SiteFooter - a site's footer, the one the Storio landing wears without its painting: the brand (logo and a line) with
# the two ways in on one row over a hairline, then every group of links on one row, then a bar with the company and the
# ways to reach it. On a phone the brand stacks, the groups go two by two and the bar stacks. Colours come from the
# theme, so it sits on any skin, light or dark.
#   SiteFooter {
#     FooterHead {
#       FooterBrand(tag: "Sells and books for you.") { Link "" -> "/" aria(label: "Home") { Image "/logo.svg" alt("Storio") } }
#       FooterActions { LinkBtn(to: "/login", variant: "outline") { Span "Sign in" }  LinkBtn(to: "/signup") { Span "Create my shop" } }
#     }
#     FooterLinks {
#       FooterCol(title: "Product") { Link "What it is" -> "/product"  Link "Prices" -> "/pricing" }
#       FooterCol(title: "Legal") { Link "Terms" -> "/terms"  Link "Privacy" -> "/privacy" }
#     }
#     FooterBar { Span "© 2026 Candhrly LLC"  Link "hello@storio.ink" -> "mailto:hello@storio.ink" }
#   }
# FooterCol(wide: "on") takes two columns of links on a phone and one long column on a desk (a long list, like trades).
# The bar puts its first child on the left and the rest on the right.
# shadcn-for-muten · part · no deps · kit.css (.cx-foot).
part SiteFooter(label: text = "Footer") {
  Footer class("cx-foot") data(trl: $label) aria(label: $label) { Stack class("cx-foot-in") { slot } }
}
part FooterHead() { Stack class("cx-foot-head") { slot } }
part FooterBrand(tag: text = "") {
  Stack class("cx-foot-brand") {
    Stack class("cx-foot-logo") { slot }
    Text "{$tag}" class("cx-foot-tag")
  }
}
part FooterActions() { Stack class("cx-foot-doors") { slot } }
part FooterLinks() { Stack class("cx-foot-grid") { slot } }
part FooterCol(title: text, wide: text = "") {
  Nav class("cx-foot-col") data(wide: $wide) aria(label: $title) {
    Span "{$title}" class("cx-foot-h")
    Stack class("cx-foot-links") { slot }
  }
}
part FooterBar() { Stack class("cx-foot-bar") { slot } }
