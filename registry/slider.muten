# Slider - Storio's slider: a range with the value in a bubble that follows the thumb and a filled track.
#   Slider(value: deposit, min: 10, max: 100, step: 10, suffix: " %", onInput: setDeposit)
# bubble: always | drag (only while moving or focused) | off.
# shadcn-for-muten · Custom · host JS slider.js (Storio's Slider, unchanged).
part Slider(value: number, min: number = 0, max: number = 100, step: number = 1, suffix: text = "", bubble: text = "always", onInput: action) {
  Custom Slider inputs(value: $value, min: $min, max: $max, step: $step, suffix: $suffix, bubble: $bubble) on(input: $onInput) class("cx-mslider-host")
}
