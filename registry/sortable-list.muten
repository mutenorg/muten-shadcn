# SortableList - plain names you put in order (the layers of a design, the steps of a flow) from comma-joined text:
# the same rows and feel as Sortable (the grip, the others making room, Up/Down on the focused grip).
#   state { layers = "Fondo,Jugador,Interfaz" : text }   action reorder(v: text) mutates layers { layers.set(v) }
#   SortableList(items: layers, label: "Layers", onReorder: reorder)
# For rows with a price or details use Sortable with SortItem. shadcn-for-muten · Custom · sortable-list.js.
part SortableList(items: text, label: text = "Order", onReorder: action) { Custom SortableList inputs(items: $items, label: $label) on(reorder: $onReorder) class("cx-slist-host") }
