# StampCard - a loyalty card: stamps toward a reward (good for any shop).
#   StampCard(store: "Barbería El Roble", owner: "Laura", total: 10, stamps: 7, reward: "un corte gratis")
# The words are templates (%owner %n %total %left %reward); the defaults are Spanish:
#   StampCard(…, title: "%owner's card", progress: "%n of %total · %left to go for %reward", complete: "Complete! %reward earned.",
#             count: "%n of %total stamps", redeem: "Redeem reward", stamp: "Stamp a visit")
# demo "on": it stamps itself one visit at a time and starts over, for a landing; the first touch stops it.
# shadcn-for-muten · part over KitWidget (kit core).
part StampCard(store: text, owner: text, total: number = 10, stamps: number, reward: text, demo: text = "", title: text = "Cartilla de %owner", progress: text = "%n de %total · faltan %left para %reward", complete: text = "¡Completa! Ganó %reward.", count: text = "%n de %total sellos", redeem: text = "Canjear premio", stamp: text = "Sellar visita") {
  Custom KitWidget inputs(name: "stampCard", store: $store, owner: $owner, total: $total, stamps: $stamps, reward: $reward, demo: $demo, title: $title, progress: $progress, complete: $complete, count: $count, redeem: $redeem, stamp: $stamp) class("cx-stamp-host")
}
