# Stepper - where you are in a flow of a few steps. Horizontal: one short bar per step under its name, as the «Nueva
# cita» modal shows it. Vertical: numbered circles joined by a line, each with what it asks. A done step fills its
# bar (or shows a check); the current one is marked and read out as the current step.
#   Stepper(count: 4, label: "Paso 2 de 4: Servicio") { Step(num: "1", label: "Cliente", state: "done")  Step(num: "2", label: "Servicio", state: "now") … }
#   Stepper(count: 3, orientation: "vertical") { Step(num: "1", label: "Tu negocio", description: "Nombre y rubro", state: "done") … }
# look "list" (vertical): a numbered list for «how it works», ruled rows and a round number, the current one filled.
# state: done | now | "" (to come). shadcn-for-muten · part · no deps · kit.css (.cx-stepper).
part Stepper(count: number, orientation: text = "horizontal", label: text = "", look: text = "") {
  Stack class("cx-stepper cx-stp") data(slot: "stepper", orientation: $orientation, look: $look) style(n: "{$count}") aria(role: "list", label: $label) { slot }
}
part Step(num: text, label: text, state: text = "", description: text = "") {
  Stack class("cx-step cx-stp-step") data(state: $state) aria(role: "listitem", current: $state == "now") {
    Stack class("cn-progress cx-stp-bar") data(slot: "progress") { Stack class("cn-progress-indicator") data(slot: "progress-indicator") }
    Stack class("cx-stp-dot") { Span "{$num}" class("cx-stp-num")  Icon "lucide:check" class("cx-stp-check") }
    Stack class("cx-stp-text") {
      Span "{$label}" class("cx-text cx-stp-label") data(slot: "text", variant: "caption")
      Text "{$description}" class("cx-stp-desc")
    }
  }
}
