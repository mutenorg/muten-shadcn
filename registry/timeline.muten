# Timeline - what happened, in order: a dot and a line join the events; the last one (where things stand now) is
# marked. Each event has what happened, when, and an optional detail.
#   Timeline(label: "Order history") {
#     TimelineItem(title: "Order received", time: "today · 10:38")
#     TimelineItem(title: "Waiting for your review", time: "now", state: "now")
#   }
# state: "" (past) | now (where it stands) | next (still to come, faded).
# shadcn-for-muten · part · no deps · kit.css (.cx-timeline).
part Timeline(label: text = "") { Stack class("cx-timeline cx-tl") aria(role: "list", label: $label) { slot  ListMotion() } }
part TimelineItem(title: text, time: text = "", description: text = "", state: text = "") {
  Stack class("cx-tl-item") data(state: $state) aria(role: "listitem") {
    Span "{$title}" class("cx-text cx-tl-title") data(slot: "text", variant: "body")
    Text "{$description}" class("cx-tl-desc")
    Span "{$time}" class("cx-text") data(slot: "text", variant: "caption")
  }
}
