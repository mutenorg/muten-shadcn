# Toggle - a button that stays pressed (bold, favourite, “today only”). The page owns the bool and the action.
#   state { bold = false : bool }   action toggleBold() mutates bold { bold.toggle() }
#   Toggle(on: bold, onToggle: toggleBold, label: "Bold") { Icon "lucide:bold" }
#   Toggle(on: today, onToggle: toggleToday, variant: "outline") { Icon "lucide:calendar"  Span "Today only" }
# variant: default | outline · size: sm | default | lg · label: the name of an icon-only toggle.
# shadcn-for-muten · part · no deps · Nova (.cn-toggle, pressed = aria-pressed).
part Toggle(on: bool, onToggle: action, variant: text = "default", size: text = "default", label: text = "") {
  Button -> $onToggle class("cn-toggle cn-toggle-variant-{$variant} cn-toggle-size-{$size} cn-toggle-group-item") data(slot: "toggle", variant: $variant, size: $size, name: $label) aria(pressed: $on, label: $label) { slot }
}
