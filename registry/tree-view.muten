# TreeView - folders and files: a folder opens and closes, a file is picked. Keyboard as a real tree: Up/Down move,
# Right opens (or steps in), Left closes (or goes to the parent), Enter picks. Two ways to feed it:
#   nested: data [{name, children}] - a file emits its "/path".   TreeView(data: @files, onSelect: open)
#   flat: a list of rows grouped by a key - groupKey makes the folders, labelKey the text, valueKey what a file emits.
#     TreeView(data: @tiles, labelKey: "name", valueKey: "url", groupKey: "folder", selected: tileUrl, onSelect: pick)
# selected highlights that file and opens the folders above it. shadcn-for-muten · Custom · kit.css (.cx-tree) · tree-view.js.
part TreeView(data: list, labelKey: text = "", valueKey: text = "", groupKey: text = "", selected: text = "", label: text = "Archivos", onSelect: action) {
  Custom TreeView inputs(data: $data, labelKey: $labelKey, valueKey: $valueKey, groupKey: $groupKey, selected: $selected, label: $label) on(select: $onSelect) class("cx-tree-host")
}
