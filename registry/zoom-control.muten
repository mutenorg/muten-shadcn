# Zoom Control - a  -  100%  +  widget. The PAGE owns the zoom number + the -/+ actions:
#   state { zoom = 100 : number }   action zOut mutates zoom { zoom.set(zoom - 10) }   action zIn mutates zoom { zoom.set(zoom + 10) }
#   ZoomControl(value: zoom, onOut: zOut, onIn: zIn)
# shadcn-for-muten · part · no deps · styles via the semantic .zoom-* classes in globals.css.
part ZoomControl(value: number, onOut: action, onIn: action) {
  Stack class("zoom-control") {
    Button -> $onOut class("zoom-btn") { Icon "lucide:minus" class("size-4") }
    Span "{$value}%" class("zoom-value")
    Button -> $onIn class("zoom-btn") { Icon "lucide:plus" class("size-4") }
  }
}
