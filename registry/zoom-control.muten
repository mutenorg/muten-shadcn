# ZoomControl - minus, the zoom in percent, plus. Tapping the number puts it back to 100 %. The page owns the number
# and the three actions (and the limits: switch a side off at its end with Btn's own rules).
#   ZoomControl(value: zoom, onOut: zoomOut, onIn: zoomIn, onReset: zoomReset)
# shadcn-for-muten · part · no deps · kit.css (.cx-zoom).
part ZoomControl(value: number, onOut: action, onIn: action, onReset: action) {
  Stack class("cx-zoom") data(slot: "zoom-control") aria(role: "group", label: "Zoom") {
    Button -> $onOut class("cn-button cn-button-variant-ghost cn-button-size-icon-sm group/button") data(name: "Alejar") aria(label: "Alejar") { Icon "lucide:minus" }
    Button "{$value} %" -> $onReset class("cn-button cn-button-variant-ghost cn-button-size-sm group/button cx-zoom-value") data(name: "Volver a 100 %") aria(label: "Zoom {$value} %, volver a 100")
    Button -> $onIn class("cn-button cn-button-variant-ghost cn-button-size-icon-sm group/button") data(name: "Acercar") aria(label: "Acercar") { Icon "lucide:plus" }
  }
}
